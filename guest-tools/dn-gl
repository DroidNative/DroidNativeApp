#!/bin/sh
# dn-gl: run a program with a chosen OpenGL backend.
# Usage: dn-gl <auto|zink|virgl|gl4es|llvmpipe> <command> [args...]
#   zink      desktop GL 4.6 / GLES 3.2 on Vulkan (Turnip on Adreno 6xx+)
#   virgl     desktop GL through the app's virgl server on Android's GLES
#             driver (any GPU: Mali, PowerVR, older Adreno)
#   gl4es     desktop GL 2.1 translated to GLES 2 (on the backend auto picks)
#   llvmpipe  software rendering
#   auto      zink when Turnip drives the GPU, else virgl, else llvmpipe
set -e
[ $# -ge 2 ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
backend="$1"
shift

# Record every variable this script changes (DN_GL_VARS) and its previous
# value (DN_GL_ORIG_<name>), so libdn-appenv can withdraw the choice from
# child programs (per-app setting "programs started by this app").
DN_GL_VARS=""
note() {
    case " $DN_GL_VARS " in *" $1 "*) return ;; esac
    DN_GL_VARS="$DN_GL_VARS $1"
    if eval "[ -n \"\${$1+set}\" ]"; then eval "export DN_GL_ORIG_$1=\"\$$1\""; fi
}
setv() { note "$1"; export "$1=$2"; }
unsetv() { for v; do note "$v"; unset "$v"; done; }

# Turnip runs on Adreno 6xx and newer only: older Adreno have /dev/kgsl-3d0
# too, and Zink would land on lavapipe there. vulkaninfo decides once per
# Turnip build; the answer is cached in $XDG_RUNTIME_DIR.
# Every program start pays for this, so the cached path runs one process.
has_turnip() {
    [ -e /dev/kgsl-3d0 ] || return 1
    icd=""
    for f in /usr/share/vulkan/icd.d/turnip_kgsl_icd.*.json; do
        [ -e "$f" ] && icd="$f"
    done
    [ -n "$icd" ] || return 1
    # v2: answers of the first version could be wrong (see below)
    key="v2-$(stat -c %Y /usr/lib/libvulkan_turnip_kgsl.so 2>/dev/null)"
    cache="${XDG_RUNTIME_DIR:-/tmp}/dn-gl-turnip"
    if [ -f "$cache" ] && read -r ckey canswer < "$cache" && [ "$ckey" = "$key" ]; then
        [ "$canswer" = yes ]
        return
    fi
    answer=no
    # Without display variables: vulkaninfo crashes probing X11 surfaces
    # when DISPLAY names an X server that is not there (yet)
    if env -u DISPLAY -u WAYLAND_DISPLAY TU_DEBUG="${TU_DEBUG:-noconform}" \
        VK_ICD_FILENAMES="$icd" VK_DRIVER_FILES="$icd" \
        timeout 20 vulkaninfo --summary 2>/dev/null | grep -q 'PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU'; then
        answer=yes
    fi
    echo "$key $answer" > "$cache.$$" 2>/dev/null && mv "$cache.$$" "$cache" 2>/dev/null
    [ "$answer" = yes ]
}

# The app's virgl server (env/Virgl.kt) listens on VTEST_SOCKET_NAME
has_virgl() {
    [ -S "${VTEST_SOCKET_NAME:-/run/droidnative/virgl.sock}" ]
}

if [ "$backend" = auto ]; then
    if has_turnip; then backend=zink
    elif has_virgl; then backend=virgl
    else backend=llvmpipe
    fi
fi

# Mesa's virpipe: gallium virgl over the vtest socket, presented with
# software copies (no DRM device needed)
use_virgl() {
    unsetv MESA_LOADER_DRIVER_OVERRIDE
    setv GALLIUM_DRIVER virpipe
    setv LIBGL_ALWAYS_SOFTWARE 1
    setv VTEST_SOCKET_NAME "${VTEST_SOCKET_NAME:-/run/droidnative/virgl.sock}"
}

use_llvmpipe() {
    unsetv MESA_LOADER_DRIVER_OVERRIDE
    setv GALLIUM_DRIVER llvmpipe
    setv LIBGL_ALWAYS_SOFTWARE 1
}

use_zink() {
    # With the DroidNative mesa build, EGL then presents through Vulkan WSI
    # (kopper). GALLIUM_DRIVER=zink would select the swrast copy path instead,
    # and LIBGL_ALWAYS_SOFTWARE would make Zink pick a CPU device.
    unsetv LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER
    setv MESA_LOADER_DRIVER_OVERRIDE zink
    # Low-end Adreno (a610, a702) only expose Vulkan 1.0 without this,
    # which Zink cannot use.
    setv TU_DEBUG "${TU_DEBUG:-noconform}"
}

case "$backend" in
    zink)
        use_zink
        ;;
    virgl)
        use_virgl
        ;;
    llvmpipe)
        use_llvmpipe
        ;;
    gl4es)
        if has_turnip; then use_zink
        elif has_virgl; then use_virgl
        else use_llvmpipe
        fi
        setv LD_LIBRARY_PATH "/usr/lib/gl4es${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        # gl4es must load Mesa's real EGL/GLES, not its own wrapper
        setv LIBGL_EGL /usr/lib/libEGL.so.1
        setv LIBGL_GLES /usr/lib/libGLESv2.so.2
        setv LIBGL_ES 2
        setv LIBGL_NOBANNER 1
        ;;
    *)
        echo "dn-gl: unknown backend '$backend'" >&2
        exit 2
        ;;
esac
setv DN_GL_BACKEND "$backend"
export DN_GL_VARS
exec "$@"
