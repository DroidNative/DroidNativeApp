+	if (   !(sscanf(user_path, "/proc/self/fd/%d%n", &fd, &consumed) == 1
+		 && user_path[consumed] == '\0')
+	    && !(sscanf(user_path, "/proc/%d/fd/%d%n", &pid, &fd, &consumed) == 2
+		 && user_path[consumed] == '\0'))
