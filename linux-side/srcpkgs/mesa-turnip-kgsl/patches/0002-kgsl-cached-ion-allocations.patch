@@ -108,6 +108,20 @@ bo_init_new_dmaheap(struct tu_device *dev, struct tu_bo **out_bo, uint64_t size,
    return result;
 }
 
+/* DroidNative: allocate shareable ION buffers cached, like the dma-heap
+ * "system" heap does on newer kernels. Consumers that read them with the CPU
+ * (our Wayland compositor) are much faster then; they do the cache
+ * maintenance through DMA_BUF_IOCTL_SYNC. DN_TU_ION_UNCACHED=1 reverts.
+ */
+static uint32_t
+dn_ion_flags(void)
+{
+   static int cached = -1;
+   if (cached < 0)
+      cached = !debug_get_bool_option("DN_TU_ION_UNCACHED", false);
+   return cached ? ION_FLAG_CACHED : 0;
+}
+
 static VkResult
 bo_init_new_ion(struct tu_device *dev, struct tu_bo **out_bo, uint64_t size,
                 enum tu_bo_alloc_flags flags)
@@ -115,7 +129,7 @@ bo_init_new_ion(struct tu_device *dev, struct tu_bo **out_bo, uint64_t size,
    struct ion_new_allocation_data alloc = {
       .len = size,
       .heap_id_mask = KGSL_ION_SYSTEM_HEAP_MASK,
-      .flags = 0,
+      .flags = dn_ion_flags(),
       .fd = -1,
    };
 
@@ -142,7 +156,7 @@ bo_init_new_ion_legacy(struct tu_device *dev, struct tu_bo **out_bo, uint64_t si
       .len = size,
       .align = 4096,
       .heap_id_mask = KGSL_ION_SYSTEM_HEAP_MASK,
-      .flags = 0,
+      .flags = dn_ion_flags(),
       .handle = -1,
    };
 
