# Template file for 'mesa-turnip-kgsl'
# Turnip (Mesa Vulkan for Adreno) talking to Android's KGSL kernel driver
# instead of DRM/msm. Coexists with Void's mesa packages: only the ICD and
# its library are installed, under distinct names. msm is enabled only so
# that libdrm (and with it the dmabuf/DRM WSI paths) gets compiled in.
pkgname=mesa-turnip-kgsl
version=26.2.4
revision=4
archs="aarch64* armv7l*"
build_style=meson
build_helper="qemu"
configure_args="-Dplatforms=x11,wayland
 -Dvulkan-drivers=freedreno -Dfreedreno-kmds=msm,kgsl
 -Dgallium-drivers= -Dopengl=false -Dglx=disabled -Degl=disabled
 -Dgbm=disabled -Dgles1=disabled -Dgles2=disabled -Dglvnd=disabled
 -Dllvm=disabled -Dlibunwind=disabled -Dlmsensors=disabled
 -Dvalgrind=disabled -Dvideo-codecs= -Dvulkan-layers= -Dtools=
 -Dbuild-tests=false -Db_lto=false -Dcpp_std=gnu++17"
hostmakedepends="gettext flex bison pkg-config python3-Mako python3-pycparser
 python3-yaml glslang wayland-devel wayland-protocols"
makedepends="expat-devel libdrm-devel libxshmfence-devel zlib-devel
 libzstd-devel wayland-devel wayland-protocols libX11-devel libxcb-devel
 libXext-devel libXrandr-devel libXxf86vm-devel libdisplay-info-devel"
depends="vulkan-loader"
short_desc="Mesa Turnip Vulkan driver for Adreno on Android KGSL (DroidNative)"
maintainer="DroidNative <demouser@example.invalid>"
license="MIT"
homepage="https://docs.mesa3d.org/drivers/freedreno.html"
distfiles="https://mesa3d.org/archive/mesa-${version}.tar.xz"
checksum=bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9

do_install() {
	local icd
	vinstall build/src/freedreno/vulkan/libvulkan_freedreno.so 755 \
		usr/lib libvulkan_turnip_kgsl.so
	for icd in build/src/freedreno/vulkan/freedreno_icd.*.json; do
		sed 's|"library_path": *"[^"]*"|"library_path": "/usr/lib/libvulkan_turnip_kgsl.so"|' \
			"$icd" > "${wrksrc}/turnip_kgsl_icd.json"
	done
	vinstall "${wrksrc}/turnip_kgsl_icd.json" 644 \
		usr/share/vulkan/icd.d turnip_kgsl_icd.${XBPS_TARGET_MACHINE%-musl}.json
	vlicense docs/license.rst
}
