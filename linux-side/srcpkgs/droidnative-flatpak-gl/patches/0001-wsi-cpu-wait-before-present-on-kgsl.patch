diff --git a/src/vulkan/wsi/wsi_common.c b/src/vulkan/wsi/wsi_common.c
index 411ee3e..14ecb2d 100644
--- a/src/vulkan/wsi/wsi_common.c
+++ b/src/vulkan/wsi/wsi_common.c
@@ -2886,7 +2886,8 @@ wsi_common_queue_present(const struct wsi_device *wsi,
 #endif
       }
 
-      if (wsi->sw) {
+      if (wsi->sw || (wsi->cpu_wait_before_present &&
+                      swapchain->dma_buf_semaphore == VK_NULL_HANDLE)) {
          wsi->WaitForFences(vk_device_to_handle(dev),
                             1, &swapchain->fences[image_index], true, ~0ull);
       }
diff --git a/src/vulkan/wsi/wsi_common.h b/src/vulkan/wsi/wsi_common.h
index 803d140..c0b9db4 100644
--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -157,6 +157,12 @@ struct wsi_device {
 
    bool sw;
 
+   /* DroidNative: wait for the present fence on the CPU before handing a
+    * hardware image to the window system. Used when the kernel cannot attach
+    * a sync_file to the dma-buf (no implicit sync), e.g. KGSL on Android.
+    */
+   bool cpu_wait_before_present;
+
    /* Set to true if the implementation is ok with linear WSI images. */
    bool wants_linear;
 
