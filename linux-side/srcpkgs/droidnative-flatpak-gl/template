# Template file for 'droidnative-flatpak-gl'
# Graphics drivers for Flatpak apps, laid out as a Flatpak GL extension
# (org.freedesktop.Platform.GL.droidnative, see setup.sh): Turnip on KGSL,
# Zink on top of it and Mesa's EGL/GLX with the kopper-without-DRM patch.
# Flatpak runtimes bring their own Mesa, which has none of that. No LLVM, so
# nothing here depends on libraries a runtime lacks; software rendering
# stays with the runtime's GL.default.
# The patches are copies of mesa-turnip-kgsl/patches and
# mesa/patches/droidnative-egl-kopper-without-drm.patch: keep them in sync.
pkgname=droidnative-flatpak-gl
version=26.2.4
revision=2
archs="aarch64*"
build_style=meson
build_helper="qemu"
_prefix=/usr/lib/droidnative/flatpak-gl
configure_args="--prefix=${_prefix} --libdir=lib --datadir=share
 --includedir=include --sysconfdir=etc
 -Dplatforms=x11,wayland
 -Dvulkan-drivers=freedreno -Dfreedreno-kmds=msm,kgsl
 -Dgallium-drivers=zink -Dopengl=true -Dgles1=disabled -Dgles2=enabled
 -Degl=enabled -Dglx=dri -Dglvnd=enabled -Dgbm=disabled
 -Dllvm=disabled -Dlibunwind=disabled -Dlmsensors=disabled
 -Ddisplay-info=disabled
 -Dvalgrind=disabled -Dvideo-codecs= -Dvulkan-layers= -Dtools=
 -Dbuild-tests=false -Db_lto=false -Dcpp_std=gnu++17"
hostmakedepends="gettext flex bison pkg-config python3-Mako python3-pycparser
 python3-yaml glslang wayland-devel wayland-protocols"
makedepends="expat-devel libdrm-devel libxshmfence-devel zlib-devel
 libzstd-devel wayland-devel wayland-protocols libX11-devel libxcb-devel
 libXext-devel libXrandr-devel libXxf86vm-devel libXfixes-devel
 libXdamage-devel libglvnd-devel vulkan-loader-devel"
short_desc="DroidNative graphics drivers as a Flatpak GL extension"
maintainer="DroidNative <demouser@example.invalid>"
license="MIT"
homepage="https://docs.mesa3d.org/"
distfiles="https://mesa3d.org/archive/mesa-${version}.tar.xz"
checksum=bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9
# Loaded inside Flatpak runtimes, not by the Void system
noshlibprovides=yes
noverifyrdeps=yes

post_install() {
	local ext="${DESTDIR}${_prefix}"
	local f

	# Flatpak merges these directories of all active GL extensions
	mkdir -p "${ext}/vulkan/icd.d" "${ext}/glvnd/egl_vendor.d"
	for f in "${ext}"/share/vulkan/icd.d/*.json; do
		# Bare library name: resolved through the extension's lib dir
		sed 's|"library_path": *"[^"]*"|"library_path": "libvulkan_freedreno.so"|' \
			"$f" > "${ext}/vulkan/icd.d/$(basename "$f")"
	done
	cp "${ext}"/share/glvnd/egl_vendor.d/*.json "${ext}/glvnd/egl_vendor.d/"

	# Not needed at run time
	rm -r "${ext:?}/share" "${ext:?}/include" "${ext:?}/lib/pkgconfig"
	vlicense docs/license.rst
}
